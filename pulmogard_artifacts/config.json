  "split_ratios": {
    "train": 0.7,
    "val": 0.15,
    "test": 0.15
  },
  "preprocessing": {
    "numerical": "median+StandardScaler",
    "categorical": "MostFrequent+OHE"
  },
  "target": "lung_cancer",
  "positive_class": 1
}